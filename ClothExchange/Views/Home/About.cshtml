@{
    ViewData["Title"] = "How it works";
}

<h1 class="font-heading mb-4">How ReWear works</h1>

<div class="row g-4">
    <div class="col-md-4">
        <div class="dashboard-card text-center">
            <div class="display-6 text-success mb-2"><i class="fa-solid fa-shirt"></i></div>
            <h4>1. List your clothes</h4>
            <p class="text-muted mb-0">Register, then add the clothes you do not wear anymore with size, condition and a photo link.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-card text-center">
            <div class="display-6 text-success mb-2"><i class="fa-solid fa-handshake-simple"></i></div>
            <h4>2. Request an exchange</h4>
            <p class="text-muted mb-0">Found something you like? Choose one of your own clothes to offer in return and send a request.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dashboard-card text-center">
            <div class="display-6 text-success mb-2"><i class="fa-solid fa-box-open"></i></div>
            <h4>3. Accept and swap</h4>
            <p class="text-muted mb-0">The owner accepts or rejects. When accepted, both clothes are marked as exchanged.</p>
        </div>
    </div>
</div>
