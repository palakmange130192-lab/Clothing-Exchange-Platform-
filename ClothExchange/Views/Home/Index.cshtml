@model List<Clothing>
@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 hero text-center rounded">
    <h1 class="display-5 fw-bold">Give Clothes a Second Life</h1>
    <p class="lead">Exchange clothes you don't wear with other people instead of throwing them away.</p>
    <a class="btn btn-light btn-lg" asp-controller="Clothes" asp-action="Index">Browse Clothes</a>
    <a class="btn btn-outline-light btn-lg" asp-controller="Clothes" asp-action="Create">Add Your Item</a>
</div>

<h4 class="mb-3">Latest Items</h4>
@if (Model.Count == 0)
{
    <p class="text-muted">No items yet. Be the first to add one!</p>
}
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <partial name="_ClothCard" model="item" />
        </div>
    }
</div>
