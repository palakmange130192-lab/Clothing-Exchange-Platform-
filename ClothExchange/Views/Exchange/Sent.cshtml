@model List<ExchangeRequest>
@{
    ViewData["Title"] = "Sent Requests";
}
<h3 class="mb-3">Sent Requests</h3>

@if (Model.Count == 0)
{
    <div class="alert alert-info">You have not requested any item yet.
        <a asp-controller="Clothes" asp-action="Index">Browse clothes</a></div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>You want</th>
                    <th>Owner</th>
                    <th>You offer</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr title="@r.GetSummary()">
                        <td>@r.RequestedTitle</td>
                        <td>@r.OwnerName</td>
                        <td>@r.OfferedTitle</td>
                        <td>@r.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>@r.Status</td>
                        <td>
                            @if (r.Status == "Pending")
                            {
                                <form asp-action="Cancel" asp-route-id="@r.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
