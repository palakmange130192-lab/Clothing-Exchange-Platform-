@model ExchangeRequestViewModel
@{
    ViewData["Title"] = "Request Exchange";
}
<div class="row justify-content-center">
    <div class="col-md-7">
        <h3 class="mb-3">Request Exchange</h3>
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">You want: @Model.Target.Title</h5>
                <p class="mb-0 text-muted">@Model.Target.Category | Size @Model.Target.Size | @Model.Target.Condition | Owner: @Model.Target.OwnerName</p>
            </div>
        </div>

        @if (Model.MyItems.Count == 0)
        {
            <div class="alert alert-warning">
                You need at least one available item to offer in exchange.
                <a asp-controller="Clothes" asp-action="Create">Add an item</a> first.
            </div>
        }
        else
        {
            <form asp-action="Propose" method="post">
                <input type="hidden" name="requestedItemId" value="@Model.Target.Id" />
                <div class="mb-3">
                    <label class="form-label">Which of your items will you offer?</label>
                    <select name="offeredItemId" class="form-select" required>
                        @foreach (var item in Model.MyItems)
                        {
                            <option value="@item.Id">@item.Title (@item.Size, @item.Condition)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Message (optional)</label>
                    <textarea name="message" class="form-control" rows="3" maxlength="300"></textarea>
                </div>
                <button type="submit" class="btn btn-success">Send Request</button>
                <a asp-controller="Clothes" asp-action="Details" asp-route-id="@Model.Target.Id" class="btn btn-outline-secondary">Cancel</a>
            </form>
        }
    </div>
</div>
