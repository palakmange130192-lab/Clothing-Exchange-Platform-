@model RequestViewModel
@{
    ViewData["Title"] = "Request exchange";
    string image = string.IsNullOrEmpty(Model.Wanted.ImageUrl) ? "/images/placeholder.svg" : Model.Wanted.ImageUrl;
}

<h1 class="font-heading mb-4">Request an exchange</h1>

<div class="row g-4">
    <div class="col-md-5">
        <div class="dashboard-card">
            <div class="text-muted small mb-2">You want</div>
            <img src="@image" class="img-fluid rounded-3 mb-3 w-100" style="max-height:260px;object-fit:cover;" />
            <h4 class="mb-1">@Model.Wanted.Title</h4>
            <div class="text-muted small">Size @Model.Wanted.Size &bull; @Model.Wanted.Condition &bull; by @Model.Wanted.OwnerName</div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="dashboard-card">
            @if (Model.MyClothes.Count == 0)
            {
                <p>You need at least one available item to offer in exchange.</p>
                <a asp-controller="Clothes" asp-action="Create" class="btn btn-rewear-primary">Add clothes</a>
            }
            else
            {
                using (Html.BeginForm("Create", "Exchange", new { id = Model.Wanted.Id }, FormMethod.Post))
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Which of your clothes will you offer?</label>
                        @Html.DropDownList("offeredClothId", new SelectList(Model.MyClothes, "Id", "Title"), new { @class = "form-select" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Message (optional)</label>
                        @Html.TextArea("message", "", new { @class = "form-control", rows = 3, maxlength = 300, placeholder = "Say hello to the owner" })
                    </div>
                    <button type="submit" class="btn btn-rewear-primary">Send request</button>
                    <a asp-controller="Clothes" asp-action="Details" asp-route-id="@Model.Wanted.Id" class="btn btn-rewear-outline ms-2">Cancel</a>
                }
            }
        </div>
    </div>
</div>
