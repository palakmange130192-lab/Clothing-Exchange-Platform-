@model MyRequestsViewModel
@{
    ViewData["Title"] = "Exchange requests";
}

<h1 class="font-heading mb-4">Exchange requests</h1>

<h4 class="mb-3">Received (people who want your clothes)</h4>
@if (Model.Received.Count == 0)
{
    <p class="text-muted mb-5">No requests received yet.</p>
}
else
{
    <div class="dashboard-card p-0 overflow-hidden mb-5">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>From</th><th>They want</th><th>They offer</th><th>Message</th><th>Status</th><th class="text-end">Action</th></tr>
            </thead>
            <tbody>
                @foreach (ExchangeRequest r in Model.Received)
                {
                    string cls = r.Status == "Pending" ? "badge-pending" : r.Status == "Accepted" ? "badge-available" : "badge-exchanged";
                    <tr>
                        <td>@r.RequesterName</td>
                        <td>@r.RequestedTitle</td>
                        <td>@r.OfferedTitle</td>
                        <td class="small text-muted">@r.Message</td>
                        <td><span class="badge rounded-pill @cls">@r.Status</span></td>
                        <td class="text-end">
                            @if (r.Status == "Pending")
                            {
                                using (Html.BeginForm("Accept", "Exchange", new { id = r.Id }, FormMethod.Post, false, new { @class = "d-inline" }))
                                {
                                    <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                }
                                using (Html.BeginForm("Reject", "Exchange", new { id = r.Id }, FormMethod.Post, false, new { @class = "d-inline" }))
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h4 class="mb-3">Sent (clothes you asked for)</h4>
@if (Model.Sent.Count == 0)
{
    <p class="text-muted">You have not sent any requests yet.</p>
}
else
{
    <div class="dashboard-card p-0 overflow-hidden">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>Owner</th><th>You want</th><th>You offer</th><th>Status</th><th class="text-end">Action</th></tr>
            </thead>
            <tbody>
                @foreach (ExchangeRequest r in Model.Sent)
                {
                    string cls = r.Status == "Pending" ? "badge-pending" : r.Status == "Accepted" ? "badge-available" : "badge-exchanged";
                    <tr>
                        <td>@r.OwnerName</td>
                        <td>@r.RequestedTitle</td>
                        <td>@r.OfferedTitle</td>
                        <td><span class="badge rounded-pill @cls">@r.Status</span></td>
                        <td class="text-end">
                            @if (r.Status == "Pending")
                            {
                                using (Html.BeginForm("Cancel", "Exchange", new { id = r.Id }, FormMethod.Post, false, new { @class = "d-inline" }))
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Cancel</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
