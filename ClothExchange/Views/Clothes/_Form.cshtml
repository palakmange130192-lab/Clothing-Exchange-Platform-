@model Clothing
@* Shared form fields used by both Create and Edit (PartialView) *@
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" class="form-select">
            <option value="">-- Select --</option>
            @foreach (var c in Clothing.Categories)
            {
                <option value="@c">@c</option>
            }
        </select>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Size" class="form-label"></label>
        <select asp-for="Size" class="form-select">
            <option value="">-- Select --</option>
            @foreach (var s in Clothing.Sizes)
            {
                <option value="@s">@s</option>
            }
        </select>
        <span asp-validation-for="Size" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Condition" class="form-label"></label>
        <select asp-for="Condition" class="form-select">
            <option value="">-- Select --</option>
            @foreach (var c in Clothing.Conditions)
            {
                <option value="@c">@c</option>
            }
        </select>
        <span asp-validation-for="Condition" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label class="form-label">Photo</label>
    <input type="hidden" asp-for="ImageUrl" />
    <input type="file" name="photo" accept="image/*" class="form-control" />
    <span asp-validation-for="ImageUrl" class="text-danger"></span>
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="rounded mt-2" style="max-height:150px" />
    }
</div>
