@model List<Clothing>
@{
    ViewData["Title"] = "My clothes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="font-heading mb-0">My clothes</h1>
    <a asp-action="Create" class="btn btn-rewear-primary"><i class="fa-solid fa-plus me-1"></i> Add clothes</a>
</div>

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5">You have not listed anything yet.</div>
}
else
{
    <div class="dashboard-card p-0 overflow-hidden">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Item</th>
                    <th>Category</th>
                    <th>Size</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Clothing item in Model)
                {
                    string image = string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder.svg" : item.ImageUrl;
                    <tr>
                        <td>
                            <img src="@image" style="width:48px;height:48px;object-fit:cover;border-radius:8px;" class="me-2" />
                            <a asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                        </td>
                        <td>@item.Category</td>
                        <td>@item.Size</td>
                        <td><span class="badge rounded-pill badge-@item.Status.ToLower()">@item.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            @using (Html.BeginForm("Delete", "Clothes", new { id = item.Id }, FormMethod.Post, false, new { @class = "d-inline", onsubmit = "return confirm('Delete this item?');" }))
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
