@model Clothing
@{
    ViewData["Title"] = Model.Title;
    var userId = Context.Session.GetInt32("UserId");
}

<div class="row">
    <div class="col-md-5 mb-3">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Title" />
        }
        else
        {
            <div class="cloth-img placeholder-box rounded">&#128085;</div>
        }
    </div>
    <div class="col-md-7">
        <h3>@Model.Title</h3>
        <p>
            <span class="badge bg-success">@Model.Category</span>
            <span class="badge bg-secondary">Size @Model.Size</span>
            <span class="badge bg-info text-dark">@Model.Condition</span>
            <span class="badge @(Model.Status == "Available" ? "bg-primary" : "bg-dark")">@Model.Status</span>
        </p>
        <p>@Model.Description</p>
        <p class="small text-muted">@Model.GetSummary()</p>
        <p class="text-muted">Listed by <strong>@Model.OwnerName</strong> on @Model.CreatedAt.ToString("dd MMM yyyy")</p>

        @if (Model.Status == "Available")
        {
            if (userId == null)
            {
                <a class="btn btn-success" asp-controller="Account" asp-action="Login">Login to request exchange</a>
            }
            else if (userId != Model.OwnerId)
            {
                <a class="btn btn-success" asp-controller="Exchange" asp-action="Propose" asp-route-id="@Model.Id">Request Exchange</a>
            }
            else
            {
                <a class="btn btn-outline-success" asp-action="Edit" asp-route-id="@Model.Id">Edit My Item</a>
            }
        }
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>
