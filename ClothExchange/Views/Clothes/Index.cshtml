@model List<Clothing>
@{
    ViewData["Title"] = "Explore";
}

<h1 class="font-heading mb-1">Explore clothes</h1>
<p class="text-muted mb-4">Find something you like and offer one of your own in exchange.</p>

@using (Html.BeginForm("Index", "Clothes", FormMethod.Get, new { @class = "row g-2 mb-4" }))
{
    <div class="col-md-6">
        @Html.TextBox("search", (string)ViewBag.Search, new { @class = "form-control", placeholder = "Search by title or description" })
    </div>
    <div class="col-md-4">
        @Html.DropDownList("category", new SelectList(ClothingOptions.Categories, (string)ViewBag.Category), "All categories", new { @class = "form-select" })
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-rewear-primary w-100">Search</button>
    </div>
}

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5">No clothes found.</div>
}
else
{
    <div class="row g-4">
        @foreach (Clothing item in Model)
        {
            <div class="col-sm-6 col-lg-3">
                <partial name="_ClothingCard" model="item" />
            </div>
        }
    </div>
}
