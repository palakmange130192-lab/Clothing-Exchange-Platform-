@model Clothing
<div class="card h-100 shadow-sm">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="card-img-top cloth-img" alt="@Model.Title" />
    }
    else
    {
        <div class="cloth-img placeholder-box">&#128085;</div>
    }
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="text-muted mb-1">@Model.Category | Size @Model.Size | @Model.Condition</p>
        <p class="small mb-2">By @Model.OwnerName</p>
        <a class="btn btn-sm btn-success" asp-controller="Clothes" asp-action="Details" asp-route-id="@Model.Id">View</a>
    </div>
</div>
