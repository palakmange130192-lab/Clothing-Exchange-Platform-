@model Clothing

@Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

<div class="row g-3">
    <div class="col-12">
        @Html.LabelFor(m => m.Title, new { @class = "form-label fw-semibold" })
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "e.g. Blue denim jacket" })
        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
    </div>

    <div class="col-12">
        @Html.LabelFor(m => m.Description, new { @class = "form-label fw-semibold" })
        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4, placeholder = "Brand, colour, how it fits, anything useful" })
        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
    </div>

    <div class="col-md-4">
        @Html.LabelFor(m => m.Category, new { @class = "form-label fw-semibold" })
        @Html.DropDownListFor(m => m.Category, new SelectList(ClothingOptions.Categories), "-- Select --", new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger small" })
    </div>

    <div class="col-md-4">
        @Html.LabelFor(m => m.Size, new { @class = "form-label fw-semibold" })
        @Html.DropDownListFor(m => m.Size, new SelectList(ClothingOptions.Sizes), "-- Select --", new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.Size, "", new { @class = "text-danger small" })
    </div>

    <div class="col-md-4">
        @Html.LabelFor(m => m.Condition, new { @class = "form-label fw-semibold" })
        @Html.DropDownListFor(m => m.Condition, new SelectList(ClothingOptions.Conditions), "-- Select --", new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.Condition, "", new { @class = "text-danger small" })
    </div>

    <div class="col-12">
        @Html.LabelFor(m => m.ImageUrl, new { @class = "form-label fw-semibold" })
        @Html.HiddenFor(m => m.ImageUrl)
        <input type="file" name="photo" accept="image/*" class="form-control"
               onchange="var img = document.getElementById('preview'); img.src = URL.createObjectURL(this.files[0]); img.style.display = 'block';" />
        <div class="form-text">JPG, PNG or WEBP, up to 5 MB. Everyone can see this photo.</div>
        @Html.ValidationMessageFor(m => m.ImageUrl, "", new { @class = "text-danger small" })

        <img id="preview" src="@Model.ImageUrl" alt="Preview" class="rounded-3 mt-2"
             style="max-height: 220px; display: @(string.IsNullOrEmpty(Model.ImageUrl) ? "none" : "block");" />
    </div>
</div>
